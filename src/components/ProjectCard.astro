---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  containerStatus?: string;
}

const { project, containerStatus } = Astro.props;

const statusColor =
  containerStatus === 'running'
    ? 'bg-green-500'
    : containerStatus === 'exited'
      ? 'bg-yellow-500'
      : 'bg-gray-400';

const statusLabel =
  containerStatus === 'running'
    ? 'Activo'
    : containerStatus === 'exited'
      ? 'Detenido'
      : 'Sin servicio';
---

<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h3 class="text-xl font-bold text-gray-800">{project.name}</h3>
      <span
        class={`inline-block mt-2 px-3 py-1 text-xs font-semibold rounded-full ${
          project.tag === 'Producción'
            ? 'bg-blue-100 text-blue-800'
            : project.tag === 'En desarrollo'
              ? 'bg-yellow-100 text-yellow-800'
              : 'bg-gray-100 text-gray-800'
        }`}
      >
        {project.tag}
      </span>
    </div>
    {project.container && (
      <div class="flex items-center gap-2">
        <div class={`w-3 h-3 rounded-full ${statusColor}`}></div>
        <span class="text-xs text-gray-600">{statusLabel}</span>
      </div>
    )}
  </div>

  <p class="text-gray-600 text-sm mb-4">{project.description}</p>

  {project.url && (
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded transition-colors"
    >
      Abrir →
    </a>
  )}
</div>

<style>
  :global(body) {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
  }
</style>
