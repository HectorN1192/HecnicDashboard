---
// Colorful Modern: light, playful, per-project accent colours
import { projects } from '../data/projects';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hecnic Dashboard</title>
    <style is:inline>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #f4f5f9;
            --bg-grad-1: #eef2ff;
            --bg-grad-2: #f4f5f9;
            --card: #ffffff;
            --text-primary: #111827;
            --text-secondary: #6b7280;
            --border: #eceef3;
            --shadow: 0 6px 20px rgba(17, 24, 39, 0.06);
            --shadow-hover: 0 14px 40px rgba(17, 24, 39, 0.12);
            --status-running: #22c55e;
            --status-stopped: #f59e0b;
            --status-error: #ef4444;
            --status-off: #cbd5e1;
        }

        html.dark {
            --bg: #0b0d12;
            --bg-grad-1: #14161d;
            --bg-grad-2: #0b0d12;
            --card: #161922;
            --text-primary: #f3f4f6;
            --text-secondary: #9ca3af;
            --border: #232733;
            --shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
            --shadow-hover: 0 14px 40px rgba(0, 0, 0, 0.55);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background:
                radial-gradient(1200px 600px at 80% -10%, var(--bg-grad-1), transparent 60%),
                var(--bg-grad-2);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
            transition: background 0.3s, color 0.3s;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .logo-mark {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            background: linear-gradient(135deg, #6366f1, #06b6d4);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .theme-toggle {
            background: var(--card);
            border: 1px solid var(--border);
            width: 40px;
            height: 40px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 1.05rem;
            box-shadow: var(--shadow);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .theme-toggle:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1.5rem 2rem 3rem;
        }

        .header-section {
            margin-bottom: 2rem;
        }

        .header-section h1 {
            font-size: 2.1rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 0.35rem;
        }

        .header-section p {
            color: var(--text-secondary);
            font-size: 1rem;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .project-card {
            position: relative;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: var(--shadow);
            overflow: hidden;
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .project-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: var(--accent);
        }

        .project-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .card-icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            background: var(--accent);
            box-shadow: 0 6px 16px var(--accent-soft);
        }

        .card-status {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.72rem;
            font-weight: 600;
            padding: 0.3rem 0.6rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--status) 14%, transparent);
            color: var(--status);
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--status);
        }

        .status-dot.live {
            box-shadow: 0 0 0 0 var(--status);
            animation: pulse 1.8s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--status) 60%, transparent); }
            70% { box-shadow: 0 0 0 6px transparent; }
            100% { box-shadow: 0 0 0 0 transparent; }
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            margin-bottom: 0.35rem;
        }

        .card-tag {
            display: inline-block;
            font-size: 0.68rem;
            font-weight: 600;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            margin-bottom: 0.75rem;
        }

        .card-description {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 1.25rem;
        }

        .card-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 1rem;
            border-radius: 12px;
            background: var(--accent);
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            transition: filter 0.15s ease, transform 0.15s ease;
        }

        .card-link:hover {
            filter: brightness(1.08);
            transform: translateX(2px);
        }

        .footer {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.82rem;
            margin-top: 2.5rem;
        }

        .last-update {
            font-weight: 600;
            color: var(--text-primary);
        }

        @media (max-width: 768px) {
            header, .container { padding-left: 1.25rem; padding-right: 1.25rem; }
            .header-section h1 { font-size: 1.7rem; }
            .projects-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo"><span class="logo-mark"></span> Hecnic</div>
        <button class="theme-toggle" onclick="toggleTheme()">
            <span id="theme-icon">🌙</span>
        </button>
    </header>

    <div class="container">
        <div class="header-section">
            <h1>Dashboard</h1>
            <p>Acceso centralizado a todos tus proyectos</p>
        </div>

        <div class="projects-grid" id="projects-grid"></div>

        <div class="footer">
            Última actualización: <span class="last-update" id="last-update">Cargando...</span>
        </div>
    </div>

    <script type="application/json" id="projects-data" set:html={JSON.stringify(projects)}></script>

    <script>
        const projects = JSON.parse(document.getElementById('projects-data').textContent);

        const statusMeta = {
            running: { color: '#22c55e', label: 'Activo', live: true },
            exited: { color: '#f59e0b', label: 'Detenido', live: false },
            error: { color: '#ef4444', label: 'Error', live: false },
            off: { color: '#cbd5e1', label: 'Sin servicio', live: false },
        };

        let containerStatus = {};

        async function updateStatus() {
            try {
                const response = await fetch('/api/status.json');
                if (response.ok) {
                    containerStatus = await response.json();
                }
            } catch (e) {
                console.error('Error fetching status:', e);
            }
            updateProjectCards();
            updateTimestamp();
        }

        function initials(name) {
            return name.replace(/^H/, '').slice(0, 2).toUpperCase() || name.slice(0, 2).toUpperCase();
        }

        function updateProjectCards() {
            const grid = document.getElementById('projects-grid');
            grid.innerHTML = projects.map(project => {
                const raw = containerStatus[project.container];
                const key = !project.container ? 'off'
                    : raw === 'running' ? 'running'
                    : raw === 'exited' ? 'exited'
                    : raw ? 'error' : 'off';
                const meta = statusMeta[key];
                const soft = project.accent + '55';

                return `
                    <div class="project-card" style="--accent:${project.accent};--accent-soft:${soft};--status:${meta.color}">
                        <div class="card-top">
                            <div class="card-icon">${initials(project.name)}</div>
                            <div class="card-status">
                                <span class="status-dot ${meta.live ? 'live' : ''}"></span>${meta.label}
                            </div>
                        </div>
                        <div class="card-title">${project.name}</div>
                        <span class="card-tag">${project.tag}</span>
                        <p class="card-description">${project.description}</p>
                        ${project.url ? `<a href="${project.url}" target="_blank" class="card-link">Abrir →</a>` : ''}
                    </div>
                `;
            }).join('');
        }

        function updateTimestamp() {
            document.getElementById('last-update').textContent = new Date().toLocaleTimeString('es-ES');
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('theme-icon').textContent = isDark ? '☀️' : '🌙';
        }

        function initTheme() {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = saved === 'dark' || (saved === null && prefersDark);
            if (isDark) document.documentElement.classList.add('dark');
            document.getElementById('theme-icon').textContent = isDark ? '☀️' : '🌙';
        }

        initTheme();
        updateStatus();
        setInterval(updateStatus, 30000);
    </script>
</body>
</html>
