---
// Redesign v2: Corporativo Sofisticado (Vercel/Apple style)
// Dark mode + smooth animations + premium feel
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hecnic Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-light: #f8f9fa;
            --bg-dark: #0f172a;
            --bg-card-light: #ffffff;
            --bg-card-dark: #1a2237;
            --text-primary-light: #0f172a;
            --text-primary-dark: #f1f5f9;
            --text-secondary-light: #64748b;
            --text-secondary-dark: #cbd5e1;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --border-light: #e2e8f0;
            --border-dark: #334155;
            --status-active: #10b981;
            --status-inactive: #f59e0b;
            --status-error: #ef4444;
            --shadow: 0 8px 16px rgba(15, 23, 42, 0.1);
            --shadow-dark: 0 8px 16px rgba(0, 0, 0, 0.3);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        html.dark {
            --bg: var(--bg-dark);
            --bg-card: var(--bg-card-dark);
            --text-primary: var(--text-primary-dark);
            --text-secondary: var(--text-secondary-dark);
            --border: var(--border-dark);
            --shadow: var(--shadow-dark);
        }

        html:not(.dark) {
            --bg: var(--bg-light);
            --bg-card: var(--bg-card-light);
            --text-primary: var(--text-primary-light);
            --text-secondary: var(--text-secondary-light);
            --border: var(--border-light);
            --shadow: var(--shadow);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", sans-serif;
            background: var(--bg);
            color: var(--text-primary);
            line-height: 1.6;
            transition: background 0.3s, color 0.3s;
            background: linear-gradient(135deg, var(--bg-light) 0%, #f0f4f8 100%);
        }

        html.dark body {
            background: linear-gradient(135deg, var(--bg-dark) 0%, #1a2e4a 100%);
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 2.5rem;
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(248, 249, 250, 0.8);
        }

        html.dark header {
            background: rgba(15, 23, 42, 0.8);
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 600;
            background: linear-gradient(135deg, var(--accent) 0%, #0ea5e9 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-controls {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .theme-toggle {
            background: none;
            border: 1px solid var(--border);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            cursor: pointer;
            color: var(--text-primary);
            font-size: 0.875rem;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background: var(--bg);
            border-color: var(--accent);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 3rem 2.5rem;
        }

        .header-section {
            margin-bottom: 3rem;
            animation: fadeInDown 0.6s ease-out;
        }

        .header-section h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .header-section p {
            color: var(--text-secondary);
            font-size: 1.125rem;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .project-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 0.75rem;
            padding: 1.75rem;
            transition: var(--transition);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            animation: slideUp 0.5s ease-out backwards;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
        }

        .project-card:nth-child(1) { animation-delay: 0.1s; }
        .project-card:nth-child(2) { animation-delay: 0.2s; }
        .project-card:nth-child(3) { animation-delay: 0.3s; }

        .project-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent) 0%, #0ea5e9 100%);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .project-card:hover::before {
            opacity: 1;
        }

        .project-card:hover {
            border-color: var(--accent);
            box-shadow: 0 12px 24px rgba(59, 130, 246, 0.1);
            transform: translateY(-2px);
        }

        html.dark .project-card:hover {
            box-shadow: 0 12px 24px rgba(59, 130, 246, 0.15);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .card-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--status-inactive);
            transition: background 0.3s;
        }

        .status-dot.active {
            background: var(--status-active);
            animation: pulse 2s ease-in-out infinite;
        }

        .status-dot.error {
            background: var(--status-error);
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .card-tag {
            display: inline-block;
            padding: 0.375rem 0.75rem;
            background: var(--bg);
            color: var(--accent);
            border-radius: 0.375rem;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 1rem;
            margin-top: 0.25rem;
        }

        .card-description {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.5;
            margin-bottom: 1.5rem;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .card-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            background: var(--accent);
            color: white;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            font-weight: 500;
            font-size: 0.875rem;
            text-decoration: none;
            transition: var(--transition);
        }

        .card-link:hover {
            background: var(--accent-hover);
            transform: translateX(2px);
        }

        .card-link:focus {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .footer {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.875rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
            margin-top: 3rem;
        }

        .last-update {
            font-weight: 500;
            color: var(--accent);
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            header {
                padding: 1.5rem 1.5rem;
            }

            .container {
                padding: 1.5rem;
            }

            .header-section h1 {
                font-size: 1.75rem;
            }

            .projects-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .project-card {
                padding: 1.5rem;
            }
        }

        .status-label {
            color: var(--text-secondary);
            font-size: 0.75rem;
        }

        .status-label.active {
            color: var(--status-active);
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">✨ Hecnic</div>
        <div class="header-controls">
            <button class="theme-toggle" onclick="toggleTheme()">
                <span id="theme-icon">🌙</span>
            </button>
        </div>
    </header>

    <div class="container">
        <div class="header-section">
            <h1>Dashboard</h1>
            <p>Acceso centralizado a todos tus proyectos</p>
        </div>

        <div class="projects-grid" id="projects-grid">
            <!-- Projects will be rendered here -->
        </div>

        <div class="footer">
            <p>Última actualización: <span class="last-update" id="last-update">Cargando...</span></p>
        </div>
    </div>

    <script>
        const projects = [
            {
                name: 'HecnicWeb',
                description: 'Landing page pública de Construcciones Hecnic',
                url: 'https://construccioneshecnic.es',
                container: 'hecnic-landing',
                tag: 'Producción',
            },
            {
                name: 'HecnicApp',
                description: 'App de gestión interna para Construcciones Hecnic',
                url: 'https://construccioneshecnic.es/app',
                container: 'hecnic-web',
                tag: 'Producción',
            },
            {
                name: 'CuentasPersonales',
                description: 'Gestión de finanzas personales',
                url: null,
                container: null,
                tag: 'En desarrollo',
            },
        ];

        let containerStatus = {};

        async function updateStatus() {
            try {
                const response = await fetch('/dashboard/api/status.json');
                if (response.ok) {
                    containerStatus = await response.json();
                }
            } catch (e) {
                console.error('Error fetching status:', e);
            }

            updateProjectCards();
            updateTimestamp();
        }

        function updateProjectCards() {
            const grid = document.getElementById('projects-grid');
            grid.innerHTML = projects.map(project => {
                const status = containerStatus[project.container] || null;
                const isActive = status === 'running';

                return `
                    <div class="project-card">
                        <div class="card-header">
                            <div class="card-title">${project.name}</div>
                            ${project.container ? `
                                <div class="card-status">
                                    <div class="status-dot ${isActive ? 'active' : status === 'exited' ? '' : 'error'}"></div>
                                    <span class="status-label ${isActive ? 'active' : ''}">${isActive ? 'Activo' : 'Detenido'}</span>
                                </div>
                            ` : ''}
                        </div>
                        <div class="card-tag">${project.tag}</div>
                        <p class="card-description">${project.description}</p>
                        <div class="card-footer">
                            ${project.url ? `<a href="${project.url}" target="_blank" class="card-link">Abrir →</a>` : '<div></div>'}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateTimestamp() {
            const now = new Date().toLocaleTimeString('es-ES');
            document.getElementById('last-update').textContent = now;
        }

        function toggleTheme() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('theme-icon').textContent = isDark ? '☀️' : '🌙';
        }

        function initTheme() {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = saved === 'dark' || (saved === null && prefersDark);

            if (isDark) {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').textContent = '☀️';
            } else {
                document.getElementById('theme-icon').textContent = '🌙';
            }
        }

        initTheme();
        updateStatus();
        setInterval(updateStatus, 30000);
    </script>
</body>
</html>
